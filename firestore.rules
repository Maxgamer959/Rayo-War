rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function adminDoc() {
      return get(/databases/$(database)/documents/configuracion/admin);
    }

    function adminEmails() {
      return adminDoc().data.get('emails', []);
    }

    function adminUids() {
      return adminDoc().data.get('uids', []);
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/configuracion/admin)
        && (
          request.auth.uid in adminUids()
          || request.auth.token.email in adminEmails()
        );
    }

    function canSetupAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/configuracion/admin)
        && request.auth.token.email in adminEmails();
    }

    match /configuracion/estado {
      allow read, create, update: if isSignedIn();
    }

    match /configuracion/admin {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin() || canSetupAdmin();
    }

    match /configuracion/baneados {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /baneados/{banId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /naciones/{nationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == nationId
        && request.resource.data.id_lider == request.auth.uid
        && request.resource.data.dinero >= 0;
      allow update: if isSignedIn()
        && (request.resource.data.id_lider == resource.data.id_lider || isAdmin())
        && request.resource.data.dinero >= 0;
      allow delete: if false;
    }

    match /batallas/{battleId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    match /ataques/{attackId} {
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.id_defensor == request.auth.uid
        && request.resource.data.procesado == true
        && request.resource.data.procesado != resource.data.procesado;
      allow read: if isSignedIn() && resource.data.id_defensor == request.auth.uid;
      allow delete: if false;
    }

    match /chat_global/{messageId} {
      allow read, create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /chat_alianzas/{messageId} {
      allow read, create: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /alianzas/{alianceId} {
      allow read, write: if isSignedIn();
    }

    match /comercio/{tradeId} {
      allow read, create, update: if isSignedIn();
    }

    match /onu/estado {
      allow read, create, update: if isSignedIn();
    }
  }
}

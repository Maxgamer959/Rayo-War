rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Contador de usuarios (registro)
    match /configuracion/estado {
      allow read, create, update: if isSignedIn();
    }

    // Perfil de usuario (legacy, por si se usa en el futuro)
    match /usuarios/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Naciones: lectura para ranking; creación solo la propia;
    // update permite batallas (atacante modifica al defensor) sin cambiar id_lider
    match /naciones/{nationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid == nationId
        && request.resource.data.id_lider == request.auth.uid
        && request.resource.data.dinero >= 0;
      allow update: if isSignedIn()
        && request.resource.data.id_lider == resource.data.id_lider
        && request.resource.data.dinero >= 0;
      allow delete: if false;
    }

    // Log de batallas (game.js usa "batallas", no "ataques")
    match /batallas/{battleId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    // Legacy: colección antigua de ataques
    match /ataques/{attackId} {
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.id_defensor == request.auth.uid
        && request.resource.data.procesado == true
        && request.resource.data.procesado != resource.data.procesado;
      allow read: if isSignedIn() && resource.data.id_defensor == request.auth.uid;
      allow delete: if false;
    }

    match /chat_global/{messageId} {
      allow read, create: if isSignedIn();
    }

    match /chat_alianzas/{messageId} {
      allow read, create: if isSignedIn();
    }

    match /alianzas/{alianceId} {
      allow read, write: if isSignedIn();
    }
  }
}
